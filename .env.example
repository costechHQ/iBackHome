# Copy to .env and fill in. Never commit .env. Owner: Christopher.
# Inside docker compose, DATABASE_URL, REDIS_URL and STORAGE_ENDPOINT are set for you.

ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://ibackhome:ibackhome@localhost:5432/ibackhome
REDIS_URL=redis://localhost:6379/0

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ibackhome-evidence
STORAGE_ACCESS_KEY=ibackhome
STORAGE_SECRET_KEY=ibackhome-dev-secret

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# NDPA 2023 consent: the terms of use and privacy policy versions everyone must agree to (GET/POST /me/consent).
# Change one when a new document is published and everyone is asked again.
TERMS_VERSION=2026-10-22
PRIVACY_VERSION=2026-10-22

CORS_ORIGINS=http://localhost:5173

# Which proxies may set X-Forwarded-For (uvicorn --proxy-headers). Locally nothing sits in front of
# the API, so keep 127.0.0.1. On staging/production set it to the proxy's IP range (e.g. 10.0.0.0/8),
# never "*" unless the API is reachable only through the proxy: otherwise anyone can fake their IP and
# get around the per-IP OTP limit. An empty value trusts nobody.
FORWARDED_ALLOW_IPS=127.0.0.1

# AI agents (James). Without LLM_API_KEY, agent calls return 503 llm_not_configured.
# Don't leave LLM_MODEL empty: an empty value replaces the default instead of using it.
# flash-lite (decided 2026-10-15): the free tier allows only 5 requests/minute on gemini-3.8-flash and
# one report run can need 11. Switch back with this one variable once billing is on.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Payments and escrow (Gabriel). Test-mode keys only. A webhook whose secret is empty is refused (503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
ESCROW_WEBHOOK_SECRET=
# Naira per one unit of the client's currency, as decimal strings (never floats). Don't leave empty.
FX_NGN_PER_GBP=2000
FX_NGN_PER_USD=1550
FX_NGN_PER_EUR=1700
# FX_RATES_AS_OF=2026-10-15T00:00:00Z   optional; unset means "now"
FUNDING_FEE_BPS=250
FUNDING_SUCCESS_URL=http://localhost:5173/projects/{project_id}/funding/success?session_id={CHECKOUT_SESSION_ID}
FUNDING_CANCEL_URL=http://localhost:5173/projects/{project_id}/funding/cancelled

# Notifications (Lilian). A channel whose settings are empty is off: messages fall back to the next
# channel (WhatsApp -> push -> SMS -> email). Login codes use exactly the channel asked for, so an
# unconfigured one answers 503. With ENVIRONMENT=local an unconfigured channel writes the message to
# the API log instead (read login codes with `docker compose logs api`); staging and production never do.
NOTIFY_TIMEOUT_SECONDS=10
NOTIFY_RETRY_HOURS=24
NOTIFY_MAX_ATTEMPTS=20
# Email over SMTP (any provider, e.g. smtp-relay.brevo.com).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_FROM=
# SMS through Termii (sender ID approved by Termii).
TERMII_API_KEY=
TERMII_SENDER_ID=iBackHome
TERMII_BASE_URL=https://api.ng.termii.com
# Push through Firebase Cloud Messaging: the service account key file's contents on one line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# WhatsApp Business Cloud API. Templates must be approved by Meta first (names in Docs/api-guide.md);
# WHATSAPP_USE_TEMPLATES=false sends plain text, only for test numbers that have written to us.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_LANGUAGE=en
WHATSAPP_USE_TEMPLATES=true

# Observability (Christopher). Logs are JSON on stdout with a request ID (X-Request-ID).
LOG_LEVEL=INFO
# Error tracking: leave SENTRY_DSN empty to turn it off (local). Bodies and personal data are never sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
