# Copy to .env and fill in. Never commit .env. Owner: Christopher.
# Inside docker compose, DATABASE_URL, REDIS_URL and STORAGE_ENDPOINT are set for you.

ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://ibackhome:ibackhome@localhost:5432/ibackhome
REDIS_URL=redis://localhost:6379/0

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ibackhome-evidence
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=http://localhost:5173

