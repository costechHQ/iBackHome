# Staging settings. Owner: Christopher.
# On the server: cp deploy/staging/.env.staging.example deploy/staging/.env, fill it in, chmod 600 it.
# Never commit deploy/staging/.env. Test and sandbox keys only: staging never moves real money.
# ENVIRONMENT, DATABASE_URL, REDIS_URL and FORWARDED_ALLOW_IPS are set by docker-compose.staging.yml.

# --- The server ---------------------------------------------------------------------------------
STAGING_DOMAIN=                 # e.g. api-staging.ibackhome.ng (DNS A record -> the server's IP)
STAGING_WEB_DOMAIN=             # e.g. staging.ibackhome.ng, the web app (another DNS A record -> the same IP)
ACME_EMAIL=                     # for the Let's Encrypt certificate notices
POSTGRES_PASSWORD=              # long random value: openssl rand -hex 24

# --- App ----------------------------------------------------------------------------------------
DEBUG=false
JWT_SECRET=                     # required, at least 32 random characters: openssl rand -hex 32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173   # the web app needs no entry: it calls the API from its own server (ADR 0004)
LOG_LEVEL=INFO
SENTRY_DSN=                     # optional: error tracking for API and worker
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Evidence photos: Cloudflare R2 (S3-compatible) ---------------------------------------------
# R2 > Create bucket "ibackhome-staging-evidence"; R2 > Manage API tokens > Object Read & Write on that bucket.
STORAGE_ENDPOINT=               # https://<account id>.r2.cloudflarestorage.com
STORAGE_BUCKET=ibackhome-staging-evidence
STORAGE_ACCESS_KEY=             # the token's Access Key ID
STORAGE_SECRET_KEY=             # the token's Secret Access Key

# --- AI agents (James) --------------------------------------------------------------------------
LLM_API_KEY=                    # Gemini key; empty = agents fall back (reports use the plain summary)
LLM_MODEL=gemini-3.5-flash-lite

# --- Payments and escrow (Gabriel): TEST keys only ----------------------------------------------
STRIPE_SECRET_KEY=              # sk_test_...
STRIPE_WEBHOOK_SECRET=          # whsec_... from the webhook endpoint https://<STAGING_DOMAIN>/api/v1/webhooks/stripe
PAYSTACK_SECRET_KEY=            # sk_test_... (also verifies Paystack webhooks)
PAYSTACK_BASE_URL=https://api.paystack.co
ESCROW_WEBHOOK_SECRET=          # random until a real partner signs: openssl rand -hex 32
FX_NGN_PER_GBP=2000
FX_NGN_PER_USD=1550
FX_NGN_PER_EUR=1700
FUNDING_FEE_BPS=250
# The web app's funding page: put your STAGING_WEB_DOMAIN in place of <web domain>.
FUNDING_SUCCESS_URL=https://<web domain>/projects/{project_id}/fund/{milestone_id}?session_id={CHECKOUT_SESSION_ID}
FUNDING_CANCEL_URL=https://<web domain>/projects/{project_id}/fund/{milestone_id}?cancelled=1

# --- Notifications (Lilian): at least one channel, or nobody can sign in ------------------------
NOTIFY_TIMEOUT_SECONDS=10
NOTIFY_RETRY_HOURS=24
NOTIFY_MAX_ATTEMPTS=20
EMAIL_SMTP_HOST=                # e.g. smtp-relay.brevo.com (free tier is enough for staging)
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_FROM=                     # e.g. iBackHome Staging <no-reply@ibackhome.ng>
TERMII_API_KEY=                 # SMS to Nigerian numbers
TERMII_SENDER_ID=iBackHome
TERMII_BASE_URL=https://api.ng.termii.com
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
WHATSAPP_ACCESS_TOKEN=          # after Meta approves the templates (names in Docs/api-guide.md)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_LANGUAGE=en
WHATSAPP_USE_TEMPLATES=true
