# Production settings. Owner: Christopher.
# On the server: cp deploy/production/.env.production.example deploy/production/.env, fill it in, chmod 600 it.
# Never commit deploy/production/.env. TEST keys only for the first release: real money stays off (no escrow partner is signed).
# ENVIRONMENT, DATABASE_URL, REDIS_URL and FORWARDED_ALLOW_IPS are set by docker-compose.production.yml.

# --- The server ---------------------------------------------------------------------------------
API_DOMAIN=                      # api.ibackhome.com (A record -> the server)
WEB_DOMAIN=                      # ibackhome.com, the web app (A records for it and www -> the server)
ACME_EMAIL=                     # for the Let's Encrypt certificate notices
POSTGRES_PASSWORD=              # long random value: openssl rand -hex 24

# --- App ----------------------------------------------------------------------------------------
DEBUG=false
JWT_SECRET=                     # required, at least 32 random characters: openssl rand -hex 32
NIN_ENCRYPTION_KEY=             # needed to take supervisors' NINs, at least 32 random characters: openssl rand -hex 32
# Where the supervisor application form (/supervisors) emails each new application (ADR 0005)
OPS_NOTIFY_EMAIL=ops@ibackhome.com
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://ibackhome.com   # the web app needs no entry: it calls the API from its own server (ADR 0004)
LOG_LEVEL=INFO
SENTRY_DSN=                     # optional: error tracking for API and worker
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Evidence photos: Cloudflare R2 (S3-compatible) ---------------------------------------------
# R2 > Create bucket "ibackhome-production-evidence"; R2 > Manage API tokens > Object Read & Write on that bucket.
STORAGE_ENDPOINT=               # https://<account id>.r2.cloudflarestorage.com
STORAGE_BUCKET=ibackhome-production-evidence
STORAGE_ACCESS_KEY=             # the token's Access Key ID
STORAGE_SECRET_KEY=             # the token's Secret Access Key

# --- AI agents (James) --------------------------------------------------------------------------
LLM_API_KEY=                    # Gemini key; empty = agents fall back (reports use the plain summary)
LLM_MODEL=gemini-3.5-flash-lite

# --- Payments and escrow (Gabriel): TEST keys only ----------------------------------------------
STRIPE_SECRET_KEY=              # sk_test_...
STRIPE_WEBHOOK_SECRET=          # whsec_... from the webhook endpoint https://<API_DOMAIN>/api/v1/webhooks/stripe
PAYSTACK_SECRET_KEY=            # sk_test_... (also verifies Paystack webhooks)
PAYSTACK_BASE_URL=https://api.paystack.co
ESCROW_WEBHOOK_SECRET=          # random until a real partner signs: openssl rand -hex 32
FX_NGN_PER_GBP=2000
FX_NGN_PER_USD=1550
FX_NGN_PER_EUR=1700
FUNDING_FEE_BPS=250
# The web app's funding page: put your WEB_DOMAIN in place of <WEB_DOMAIN>.
FUNDING_SUCCESS_URL=https://<WEB_DOMAIN>/projects/{project_id}/fund/{milestone_id}?session_id={CHECKOUT_SESSION_ID}
FUNDING_CANCEL_URL=https://<WEB_DOMAIN>/projects/{project_id}/fund/{milestone_id}?cancelled=1

# --- Notifications (Lilian): at least one channel, or nobody can sign in ------------------------
NOTIFY_TIMEOUT_SECONDS=10
NOTIFY_RETRY_HOURS=24
NOTIFY_MAX_ATTEMPTS=20
EMAIL_SMTP_HOST=                # e.g. smtp-relay.brevo.com (free tier is enough to start)
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_FROM=                     # e.g. iBackHome <no-reply@ibackhome.com>; the domain must pass SPF and DKIM
TERMII_API_KEY=                 # SMS to Nigerian numbers
TERMII_SENDER_ID=iBackHome
TERMII_BASE_URL=https://api.ng.termii.com
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
WHATSAPP_ACCESS_TOKEN=          # after Meta approves the templates (names in Docs/api-guide.md)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_LANGUAGE=en
WHATSAPP_USE_TEMPLATES=true
