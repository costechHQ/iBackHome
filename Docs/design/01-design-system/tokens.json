{
  "$description": "iBackHome design tokens (approved Stage 2 design system, audited in Stage 13). Hex values are sRGB.",
  "color": {
    "navy-900": {
      "value": "#131F39",
      "usage": "Primary: buttons, header and price blocks, active states"
    },
    "navy-800": {
      "value": "#1E2B4A",
      "usage": "Primary hover / pressed"
    },
    "navy-700": {
      "value": "#2A3753",
      "usage": "Raised surface on navy (inputs and chips on navy blocks)"
    },
    "navy-200": {
      "value": "#C9D3E3",
      "usage": "Text and lines on navy"
    },
    "ink": {
      "value": "#0B1324",
      "usage": "Headings and strong text"
    },
    "slate": {
      "value": "#3A4354",
      "usage": "Body text"
    },
    "muted": {
      "value": "#5F6878",
      "usage": "Secondary text (4.5:1 on white and mist)"
    },
    "white": {
      "value": "#FFFFFF",
      "usage": "Page and card background"
    },
    "mist": {
      "value": "#F4F8FB",
      "usage": "Secondary surface: secondary buttons, inputs, panels"
    },
    "canvas": {
      "value": "#F1F3F5",
      "usage": "App background behind cards; board background"
    },
    "line": {
      "value": "#E4E8EE",
      "usage": "Hairline borders and dividers"
    },
    "line-strong": {
      "value": "#7E889A",
      "usage": "Input borders, dashed placeholders (3:1 non-text contrast)"
    },
    "frame": {
      "value": "#D5DBE3",
      "usage": "Card outline, secondary button border"
    },
    "accent": {
      "value": "#2F5FC4",
      "usage": "Links, focus ring, selected states only"
    },
    "accent-hover": {
      "value": "#1F4699",
      "usage": "Link hover"
    },
    "accent-tint": {
      "value": "#E8EFFC",
      "usage": "Selected row / info chip background"
    },
    "row-highlight": {
      "value": "#F7FAFF",
      "usage": "Hovered or selected table row"
    },
    "focus-on-dark": {
      "value": "#7FA2E8",
      "usage": "Focus ring on navy surfaces"
    },
    "escrow-bar": {
      "value": "#8C97AD",
      "usage": "\"In escrow\" segment of the spend bar"
    },
    "placeholder": {
      "value": "#E6ECF3",
      "usage": "Photo / media placeholder blocks"
    },
    "camera": {
      "value": "#1B2436",
      "usage": "Camera preview surface"
    }
  },
  "status": {
    "ok": {
      "bg": "#E7F4EC",
      "fg": "#1E6B45",
      "usage": "Accepted, released, paid, verified by iBackHome"
    },
    "warn": {
      "bg": "#FDF1D8",
      "fg": "#8A5300",
      "usage": "Claimed, flagged / under review, stale, waiting"
    },
    "bad": {
      "bg": "#FDECEA",
      "fg": "#B42318",
      "usage": "Rejected, disputed, failed"
    },
    "neutral": {
      "bg": "#EEF1F5",
      "fg": "#4A5363",
      "usage": "Pending, funded, queued, draft, scheduled"
    },
    "info": {
      "bg": "#E8EFFC",
      "fg": "#2552B0",
      "usage": "Verified (awaiting approval), active, in review"
    }
  },
  "supplementary": {
    "$note": "Used on approved boards but not part of the Stage 2 token set. Confirm or replace; see PACKAGE-REPORT.md.",
    "x-placeholder-border": {
      "value": "#C2CAD5",
      "usage": "Dashed border of \"coming soon\" and empty placeholders"
    },
    "x-map-land": {
      "value": "#E6E9ED",
      "usage": "Map illustration: plots"
    },
    "x-map-block": {
      "value": "#E2E6EB",
      "usage": "Map illustration: buildings"
    },
    "x-whatsapp-wallpaper": {
      "value": "#ECE7DF",
      "usage": "WhatsApp chat background in phone mocks (third-party UI)"
    },
    "x-whatsapp-bubble-out": {
      "value": "#DCE8FB",
      "usage": "Outgoing chat bubble in the assistant mock"
    },
    "x-chat-bg": {
      "value": "#ECE9E4",
      "usage": "Chat background in the invitation mock"
    },
    "x-on-navy-muted": {
      "value": "#9AA6BB",
      "usage": "Small caps headings in the footer; disabled text on navy"
    },
    "x-ok-on-dark": {
      "value": "#8FD3AE",
      "usage": "Success icon on a navy toast"
    },
    "x-bad-on-dark": {
      "value": "#F1C4BF",
      "usage": "Error text on a navy surface"
    },
    "x-bad-icon-on-dark": {
      "value": "#F4A79F",
      "usage": "Error icon on a navy toast"
    },
    "x-destructive-hover": {
      "value": "#912018",
      "usage": "Destructive button hover"
    }
  },
  "font": {
    "family": {
      "sans": "'Inter', 'Segoe UI', Roboto, Arial, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace"
    },
    "weights": [
      400,
      500,
      600,
      700
    ],
    "features": "tabular-nums for money, counts and times"
  },
  "type": {
    "display": {
      "size": 56,
      "lineHeight": 62,
      "weight": 700,
      "letterSpacing": "-0.02em",
      "usage": "Public-site hero"
    },
    "h1": {
      "size": 36,
      "lineHeight": 44,
      "weight": 700,
      "letterSpacing": "-0.02em",
      "usage": "Page title"
    },
    "h2": {
      "size": 28,
      "lineHeight": 36,
      "weight": 700,
      "letterSpacing": "-0.02em",
      "usage": "Section title (26–30 on the boards)"
    },
    "h3": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "letterSpacing": "-0.01em",
      "usage": "Card title (17–22 on the boards)"
    },
    "body-lg": {
      "size": 16,
      "lineHeight": 24,
      "weight": 400,
      "letterSpacing": "0",
      "usage": "Client body copy"
    },
    "body": {
      "size": 15,
      "lineHeight": 24,
      "weight": 400,
      "letterSpacing": "0",
      "usage": "Default body"
    },
    "small": {
      "size": 14,
      "lineHeight": 20,
      "weight": 400,
      "letterSpacing": "0",
      "usage": "Secondary text (13–14 on the boards)"
    },
    "caption": {
      "size": 12,
      "lineHeight": 16,
      "weight": 600,
      "letterSpacing": "0.06em",
      "usage": "Uppercase labels"
    },
    "android-body": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400,
      "letterSpacing": "0",
      "usage": "Android minimum body"
    },
    "ops-body": {
      "size": 13,
      "lineHeight": 19,
      "weight": 400,
      "letterSpacing": "0",
      "usage": "Ops console dense tables"
    },
    "mono": {
      "size": 13,
      "lineHeight": 20,
      "weight": 500,
      "letterSpacing": "0",
      "usage": "IDs: EV-, R-, P-, T-, O-, D- (JetBrains Mono)"
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radius": {
    "tag": 6,
    "control": 8,
    "card": 12,
    "dialog": 16,
    "sheet": 20,
    "device": 24,
    "pill": 999
  },
  "shadow": {
    "card": "0 1px 2px rgba(19,31,57,0.06)",
    "raised": "0 4px 12px rgba(19,31,57,0.08)",
    "dialog": "0 24px 48px rgba(11,19,36,0.24)"
  },
  "target": {
    "web": 44,
    "android": 48
  },
  "frames": {
    "desktop": "1280 (client, contractor, supplier) / 1440 (ops, public site)",
    "mobile-web": "390×844",
    "android": "360×800"
  },
  "rules": [
    "Status colours appear only inside chips and alerts.",
    "Accent is for links, focus and selected states only.",
    "No gradients.",
    "8px grid."
  ]
}
